diff --git a/assets/js/weather.js b/assets/js/weather.js
new file mode 100644
index 0000000..3ba2de4
--- /dev/null
+++ b/assets/js/weather.js
@@ -0,0 +1,49 @@
+// Fetch once per click, then reload saved data. A normal page load never saves.
+const weatherButton = document.getElementById('refresh-weather');
+if (weatherButton) {
+    const mapBox = document.getElementById('location-map');
+    const message = document.getElementById('weather-status');
+    const savedPanel = document.getElementById('saved-assessment');
+    let selected = mapBox.dataset.selected !== '0' ? {location_id: mapBox.dataset.selected} : null;
+
+    async function refreshWeather() {
+        if (!selected || mapBox.dataset.busy === '1') return;
+        mapBox.dataset.busy = '1';
+        weatherButton.disabled = true;
+        message.textContent = 'Fetching weather and saving the reading…';
+        const controller = new AbortController();
+        const timeout = setTimeout(() => controller.abort(), 20000);
+        try {
+            const response = await fetch(mapBox.dataset.base + '/api/readings.php', {
+                method: 'POST', body: new URLSearchParams(selected), signal: controller.signal
+            });
+            const data = await response.json();
+            if (!response.ok || !data.location_id) throw new Error(data.error || 'Weather could not be saved.');
+            window.location.href = '?location_id=' + data.location_id;
+        } catch (error) {
+            message.textContent = (error.name === 'AbortError' ? 'The request timed out. Reload saved readings before retrying.' : error.message)
+                + ' Existing readings were kept. You can use “View saved readings here” for an existing location.';
+        } finally {
+            clearTimeout(timeout);
+            mapBox.dataset.busy = '0';
+            weatherButton.disabled = false;
+        }
+    }
+    document.addEventListener('location-selected', event => {
+        selected = event.detail;
+        document.getElementById('assessment-location').textContent = document.getElementById('map-selection').textContent;
+        // Avoid showing the previous location's assessment beside a new point.
+        savedPanel.hidden = String(selected.location_id || '') !== mapBox.dataset.selected;
+        weatherButton.disabled = false;
+        refreshWeather();
+    });
+    weatherButton.addEventListener('click', refreshWeather);
+    const expires = Number(savedPanel.dataset.expires);
+    if (expires > 0) {
+        setTimeout(() => {
+            const badge = document.getElementById('current-category');
+            if (badge) badge.hidden = true;
+            document.getElementById('assessment-state').textContent = 'Outdated data · current assessment unavailable';
+        }, Math.max(0, expires * 1000 - Date.now()));
+    }
+}
diff --git a/class/RiskAnalyzer.php b/class/RiskAnalyzer.php
new file mode 100644
index 0000000..21c9bb4
--- /dev/null
+++ b/class/RiskAnalyzer.php
@@ -0,0 +1,45 @@
+<?php
+// These are the original SmartSlope prototype thresholds, not validated warnings.
+class RiskAnalyzer {
+    const VERSION = 'prototype-1';
+    const MAX_AGE = 10800; // Three hours, measured from the rainfall window end.
+    const THRESHOLDS = [
+        'high' => [50, 100, 150],
+        'medium' => [25, 50, 100],
+        'normal' => [10, 25, 50]
+    ];
+
+    public function analyze($one_hour, $day, $three_days) {
+        $totals = [$one_hour, $day, $three_days];
+        foreach ($totals as $value) {
+            if (!is_numeric($value) || !is_finite((float) $value) || $value < 0 || $value > 99999.99) return null;
+        }
+        if ($one_hour > $day || $day > $three_days) return null;
+        foreach (self::THRESHOLDS as $category => $limits) {
+            for ($i = 0; $i < 3; $i++) {
+                if ($totals[$i] >= $limits[$i]) return $category;
+            }
+        }
+        return 'low';
+    }
+
+    public function assess($reading, $now = null) {
+        $result = ['status' => 'unavailable', 'category' => null, 'expires_at' => null];
+        if (!$reading) return $result;
+        $result['status'] = 'incomplete';
+        $category = $this->analyze($reading['rainfall_1h'], $reading['rainfall_24h'], $reading['rainfall_72h']);
+        $observed = DateTimeImmutable::createFromFormat('!Y-m-d H:i:s', $reading['observed_at'] ?? '', new DateTimeZone('UTC'));
+        $end = DateTimeImmutable::createFromFormat('!Y-m-d H:i:s', $reading['rainfall_window_end'] ?? '', new DateTimeZone('UTC'));
+        $now = $now ?? time();
+        if (!$category || !$observed || !$end
+            || $observed->format('Y-m-d H:i:s') !== $reading['observed_at']
+            || $end->format('Y-m-d H:i:s') !== $reading['rainfall_window_end']
+            || $observed->getTimestamp() > $now + 300
+            || $end->getTimestamp() !== intdiv($observed->getTimestamp(), 3600) * 3600
+            || ($reading['rule_version'] ?? '') !== self::VERSION) return $result;
+        $result['category'] = $category;
+        $result['expires_at'] = $end->getTimestamp() + self::MAX_AGE;
+        $result['status'] = $now >= $result['expires_at'] ? 'outdated' : 'current';
+        return $result;
+    }
+}
